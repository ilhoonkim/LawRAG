# Copy to local.env. Priority: process environment > local.env > .env.
# This example keeps BOTH existing OpenAI connections active.
# Change either selector to company to use the configured internal server.
# For direct emb-bge-m3-ko vLLM embeddings, use local.env.vllm.example.
# EMBEDDING_BACKEND=vllm uses COMPANY_EMBEDDING_* over HTTP, without MQ.
CHAT_BACKEND=openai
EMBEDDING_BACKEND=openai

# OpenAI-compatible API base URLs, including /v1 (no /chat/completions suffix).
COMPANY_CHAT_BASE_URL=http://10.0.0.20:8000/v1
COMPANY_CHAT_MODEL=company-sllm
COMPANY_CHAT_API_KEY=
COMPANY_EMBEDDING_BASE_URL=http://10.0.0.21:8000/v1
COMPANY_EMBEDDING_MODEL=company-embedding
COMPANY_EMBEDDING_API_KEY=

# json_object: send response_format=json_object.
# prompt: omit response_format, still require and validate JSON content.
# auto: keep the existing model-based JSON/schema selection.
COMPANY_CHAT_JSON_MODE=json_object
AI_TIMEOUT_SECONDS=120

# Lower these if your model/server accepts shorter input or smaller batches.
# Bytes are NOT tokens. Changing input split size requires reindexing.
EMBEDDING_MAX_INPUT_BYTES=8000
EMBEDDING_BATCH_SIZE=16
EVIDENCE_REVIEW_MAX_CHARS=60000
CONTEXT_MAX_CHARS=60000

# Optional: isolate vectors when experimenting with a different embedding model.
# DATA_DIR=data-company

# NSE MQ: configured credentials/model add LOCAL_MODEL to the chat model list.
# Keep CHAT_BACKEND=openai for GPT default; local_model makes MQ the default.
# Use the broker host/AMQP port, NOT NSE HTTP port or RabbitMQ management port.
NSE_MQ_HOST=
NSE_MQ_PORT=35672
NSE_MQ_VHOST=/
NSE_MQ_USERNAME=
NSE_MQ_PASSWORD=
# If both credentials are blank, read ~/.netrc (Windows: _netrc also supported).
# NSE_MQ_NETRC=C:/Users/your-name/.netrc
NSE_MQ_TLS=false
# NSE_MQ_CA_FILE=C:/certs/company-ca.pem

# Explicit queue wins; otherwise nse_request + NSE_MQ_SUFFIX (or SUFFIX).
NSE_MQ_REQUEST_QUEUE=nse_request
# Each request creates nse_result_kih_<uuid>; shared result queues are NEVER consumed.
NSE_MQ_REPLY_PREFIX=nse_result_kih
# NSE_MQ_SUFFIX=your_environment
# Numeric tb_dap_physical_model.physical_model_id; do not guess between 22/34.
NSE_PHYSICAL_MODEL_ID=
NSE_MAX_TOKENS=4096
NSE_DOMAIN_ID=
NSE_USER_ID=

# MQ embeddings: independent of GPT/LOCAL_MODEL chat selection.
# EMBEDDING_BACKEND=local_embedding
# LOCA_EMBEDDING is also accepted as an alias for local_embedding.
# Embeddings use served_model_name, NOT the numeric LLM physical_model_id.
NSE_EMBEDDING_MODEL=emb-bge-m3-ko
# Bump when weights behind the same model name change; then reindex.
NSE_EMBEDDING_REVISION=
