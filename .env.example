# Copy to .env. Never commit credentials.
LAW_API_OC=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4.1
# Selected chat model also handles rewriting and relevance verification.
SEARCH_CANDIDATE_LIMIT=20
SEARCH_THRESHOLD=0.48
DATA_DIR=data
# Field-aware article retrieval; RRF changes ranking, not the content threshold.
SEARCH_FUSION=weighted
REFERENCE_LIMIT=40
CONTEXT_MAX_CHARS=60000
