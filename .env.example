# Copy to .env. Never commit credentials.
LAW_API_OC=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4.1
# Selected chat model also handles rewriting and relevance verification.
SEARCH_CANDIDATE_LIMIT=15
DATA_DIR=data
# Web search/chat always use RRF fusion and threshold 0.3 (not configurable).
REFERENCE_LIMIT=40
CONTEXT_MAX_CHARS=60000
# Optional company endpoints and independent chat/embedding selection:
# copy local.env.example to local.env. Missing local.env preserves these settings.
