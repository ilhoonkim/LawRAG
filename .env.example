# Copy to .env. Never commit credentials.
LAW_API_OC=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
SEARCH_THRESHOLD=0.48
DATA_DIR=data
# Title/body scores are blended independently, then combined.
SEARCH_TITLE_WEIGHT=0.35
SEARCH_MIN_TITLE_SCORE=0.15
SEARCH_MIN_BODY_SCORE=0.20
