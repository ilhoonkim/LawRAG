# Copy to local.env to use GPT chat + direct bge-m3-ko vLLM embeddings.
# Existing OpenAI chat model/key and LAW_API_OC are read from .env.
# Priority: process environment > local.env > .env. Restart after changes.
CHAT_BACKEND=openai
EMBEDDING_BACKEND=vllm

# Keep port-forward running on the SAME PC as the LawRAG Python server:
# kubectl --context=kdev-context -n davinci-ragllm port-forward svc/emb-bge-m3-ko-vllm-predictor 8000:80
# The app appends /embeddings; do not put /embeddings in BASE_URL.
COMPANY_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
COMPANY_EMBEDDING_MODEL=emb-bge-m3-ko
# Empty means no Authorization header. The OpenAI key is never used here.
COMPANY_EMBEDDING_API_KEY=
# Local port forwarding must bypass a company HTTP proxy.
NO_PROXY=localhost,127.0.0.1,::1

AI_TIMEOUT_SECONDS=120
# UTF-8 byte budget, NOT tokens. The server's max_model_len is 8192 tokens.
# Long articles are split without dropping text, then their vectors combined.
EMBEDDING_MAX_INPUT_BYTES=8000
EMBEDDING_BATCH_SIZE=16

# Neither MQ settings nor NSE_PHYSICAL_MODEL_ID are needed for embeddings.
# Test without changing DB: python -m app.check_ai
# Existing data: stop the app, then python -m app.reindex_embeddings
# Start the app after successful reindex: python -m app.serve --lan
